# Copy to .env and edit. Every value here is optional; these are the defaults.

# ---- server ----
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=info                 # debug | info | warn | error | silent

# ---- browser ----
HEADLESS=true                  # false (or HEADED=1) opens a visible window
USER_DATA_DIR=.browser-profile # persists cookies/consent between runs; "" = throwaway
NAVIGATION_TIMEOUT_MS=60000
DETAIL_TIMEOUT_MS=15000

# ---- how much, how fast ----
MAX_RESULTS=40                 # 1-200. Large runs take a long time and raise block risk.
MAX_SCROLLS=10
SCROLL_SETTLE_MS=8000          # how long to wait for a lazy-loaded batch before giving up
SCROLL_STRIKES=3               # consecutive no-growth scrolls before stopping
PAUSE_MIN_MS=2000              # floor is 1000ms and is enforced, whatever you set
PAUSE_MAX_MS=5000

# ---- email lookup (never touches Google) ----
LOOKUP_EMAILS=true
EMAIL_TIMEOUT_MS=10000
MAX_PAGE_BYTES=2000000         # ceiling on a fetched page body
RESPECT_ROBOTS=true            # leave this on

# ---- storage ----
RUNS_DIR=runs
